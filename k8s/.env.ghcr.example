# Copy → .env.ghcr (KHÔNG commit — đã có trong .gitignore)
# Dùng cho: docker login (Mac) + kubectl ghcr-secret (cp-1)

# Username đăng nhập GitHub / docker login (có thể viết hoa)
GITHUB_USER=PhamTuanKhoi

# Image path GHCR — BẮT BUỘC chữ thường
GHCR_USER=phamtuankhoi

# PAT: GitHub → Settings → Developer settings → Personal access tokens
# Quyền: read:packages, write:packages (classic) hoặc packages read/write (fine-grained)
GITHUB_PAT=ghp_REPLACE_ME
