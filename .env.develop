ENV_FILE=.env.develop

CONTAINER_NAME=mysql_db
MYSQL_ROOT_PASSWORD=Mysql7!js
MYSQL_DATABASE=findsource
MYSQL_USER=findsource
MYSQL_PASSWORD=Mysql7!js
MYSQL_PORT=3306

# Port trên host
API_PORT=7003
WEB_PORT=3000
ADMIN_PORT=5173
DB_PUBLISH_PORT=3306

# MySQL — API kết nối (phải khớp MYSQL_* ở trên)
DB_DIALECT=mysql
DB_NAME=findsource
DB_USERNAME=findsource
DB_PASSWORD=Mysql7!js
DB_ROOT_PASSWORD=Mysql7!js

# API runtime (env_file → container api)
OFFICE_BE_PORT=7003
FE_URLS=https://findsourcevn.com,https://www.findsourcevn.com,https://admin.findsourcevn.com

JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_EXPIRE_TIME=1d
JWT_REFRESH_EXPIRE_TIME=7d

# Build args — web (URL public qua Nginx)
REACT_APP_API_BASE_URL=https://be.findsourcevn.com
REACT_APP_CONTACT_PHONE=0333132323
REACT_APP_ZALO_CHAT_URL=https://zalo.me/0333132323
REACT_APP_MESSENGER_CHAT_URL=https://www.messenger.com/t/100029618768304

# Build args — admin
VITE_API_BASE_URL=https://be.findsourcevn.com
